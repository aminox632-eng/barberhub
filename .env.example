# MongoDB Atlas (already injected by the Vercel "atlas-blue-ball" integration)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/barberhub?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Public site URL (SEO: sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/seed (demo barbers). Remove after seeding in production.
SEED_SECRET=change-me
